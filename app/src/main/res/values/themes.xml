<!--
  Theme.SysMonWidget: a plain (non-DayNight) dark theme so the app always
  looks the same regardless of the phone's system dark-mode setting — same
  black/teal/cyan language as the Today, Weather and Garage apps.
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.SysMonWidget" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/retro_teal</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorAccent">@color/retro_cyan</item>
        <item name="colorSecondary">@color/retro_teal</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor" tools:targetApi="lollipop">@color/black</item>
        <item name="android:navigationBarColor" tools:targetApi="lollipop">@color/black</item>
        <item name="android:textColorPrimary">@color/retro_white</item>
        <item name="android:textColorSecondary">@color/retro_white</item>
        <item name="android:textColorHint">@color/widget_text_secondary</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.SysMonWidget.Dialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.SysMonWidget.Dialog</item>
    </style>

    <!-- Add/Edit device popup: near-black panel, teal buttons. -->
    <style name="ThemeOverlay.SysMonWidget.Dialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">@color/retro_teal</item>
        <item name="colorAccent">@color/retro_teal</item>
        <item name="android:windowBackground">@drawable/app_dialog_background</item>
        <item name="android:textColorPrimary">@color/retro_white</item>
        <item name="android:textColorHint">@color/widget_text_secondary</item>
    </style>

    <!-- Teal-outlined, transparent-fill button used for primary actions in the app. -->
    <style name="Widget.SysMonWidget.OutlinedButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/retro_teal</item>
        <item name="strokeWidth">2dp</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:textColor">@color/retro_teal</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:minHeight">56dp</item>
        <item name="rippleColor">#3300E0B8</item>
    </style>

    <!-- Small icon-only text buttons (edit / delete) on each device card. -->
    <style name="Widget.SysMonWidget.IconButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minWidth">44dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:textSize">18sp</item>
        <item name="rippleColor">#3300E0B8</item>
    </style>
</resources>
