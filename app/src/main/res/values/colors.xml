<!--
  Same dark-card palette as the rest of the widget family (Today, Weather,
  Garage): pitch-black card, teal outline, one accent per role — teal for
  stat labels/section headers, cyan for device names, yellow for the app
  title, white for values, dim grey for secondary info (IP, timestamps).
  StatsFormat.kt repeats the teal/white hex values for its SpannableStrings.
-->
<resources>
    <color name="black">#000000</color>
    <color name="white">#FFFFFF</color>

    <!-- Near-black fill for in-app cards/dialog fields; the widget itself is pure black. -->
    <color name="widget_bg">#0B0B10</color>
    <color name="widget_text_secondary">#8C8C99</color>

    <color name="icon_bg">#4C4C4C</color>

    <color name="retro_yellow">#FFD400</color>
    <color name="retro_cyan">#00D9FF</color>
    <color name="retro_teal">#00E0B8</color>
    <color name="retro_white">#F5F5FF</color>
    <color name="retro_white_dim">#8C8C99</color>
    <color name="retro_red">#E8404D</color>
</resources>
