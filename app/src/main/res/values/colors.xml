<!--
  Every named color the app uses, in one place. Any layout XML can reference one
  of these with "@color/retro_cyan" etc, and any Kotlin code can look one up with
  ContextCompat.getColor(context, R.color.retro_cyan) or (as StatsFormat.kt does
  for its SpannableString colors) Color.parseColor("#00E5FF") using the same hex
  value directly. Centralizing colors here means changing the whole app's theme
  is mostly just editing this one file.
-->
<resources>
    <color name="teal_700">#00695C</color>
    <color name="black">#000000</color>
    <color name="white">#FFFFFF</color>

    <!--
      #FF000000 is an 8-digit hex color: the first pair (FF) is the alpha
      (opacity) channel, and 000000 is plain black — so this is fully-opaque
      black. Kept for the widget's border-shape fill (the sunset gradient sits
      underneath it via a separate layer — see drawable/widget_background.xml).
    -->
    <color name="widget_bg">#FF000000</color>
    <color name="widget_text_secondary">#B0BEC5</color>

    <!--
      Synthwave "sunset over a grid" palette — a moody, DARK gradient (night
      sky fading into a barely-lit dusk horizon) with neon cyan/magenta/orange
      accents on top, used consistently across both the home-screen widget and
      the app's own screens. Kept deliberately low-brightness throughout —
      this is background art, not something that should compete with text —
      combined with the scrim color below for guaranteed contrast.
    -->
    <color name="sunset_top">#08040F</color>
    <color name="sunset_mid">#2B0E30</color>
    <color name="sunset_bottom">#341509</color>

    <!--
      A translucent near-black layer painted OVER the gradient+grid, UNDER the
      text (see drawable/widget_background.xml / app_background.xml). This is
      what actually guarantees text stays readable: no matter how the gradient
      or grid lines happen to fall behind a given piece of text, this scrim
      darkens everything underneath it by a fixed, predictable amount first.
    -->
    <color name="retro_scrim">#B3000000</color>

    <color name="retro_cyan">#00E5FF</color>
    <color name="retro_magenta">#FF4FA3</color>
    <color name="retro_orange">#FF9F5A</color>
    <color name="retro_white">#F2F2FF</color>
</resources>
