<?xml version="1.0" encoding="utf-8"?>
<!--
  This is the widget's OWN layout — what actually gets drawn on the home screen.
  It's referenced from two places: sysmon_widget_info.xml's
  android:initialLayout, and directly by name in
  SysMonWidgetProvider.updateOneWidget() via RemoteViews(context.packageName,
  R.layout.widget_sysmon).

  IMPORTANT: widget layouts can ONLY use a small whitelist of View types that
  Android's RemoteViews system knows how to recreate inside the separate
  launcher process — things like LinearLayout, TextView, ListView, ImageView,
  Button. You can't drop in arbitrary custom Views the way you can in a normal
  Activity layout.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <!--
      Title row: the device name on the left (growing to fill available space,
      centered within it) and the device's IP address on the right in pink.
      Both TextViews' actual text are set in code, per-widget, inside
      SysMonWidgetProvider.updateOneWidget() via views.setTextViewText(...).
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/retro_purple"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="--" />

        <TextView
            android:id="@+id/ipText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/retro_pink"
            android:textSize="11sp"
            android:singleLine="true"
            android:text="" />

    </LinearLayout>

    <!--
      The scrollable stats list. Unlike a normal ListView in an Activity, this
      one gets its rows from a RemoteViewsService (SysMonRemoteViewsService.kt)
      instead of a plain in-process Adapter — see
      SysMonWidgetProvider.attachListAdapter() for how the two get connected.
      layout_height="0dp" + layout_weight="1" again means "fill whatever space
      is left over" after the title row above and the timestamp row below take
      what they need.
    -->
    <ListView
        android:id="@+id/statsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:divider="@null"
        android:scrollbars="none" />

    <!--
      Small status line at the bottom: either "Updated HH:mm" on a successful
      refresh, or "Unreachable — last HH:mm" if the device couldn't be reached.
      Text set in code by SysMonWidgetProvider.updateOneWidget().
    -->
    <TextView
        android:id="@+id/updatedText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/retro_pink"
        android:textSize="11sp"
        android:gravity="center"
        android:text="" />

</LinearLayout>
