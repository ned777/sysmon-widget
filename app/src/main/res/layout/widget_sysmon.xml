<?xml version="1.0" encoding="utf-8"?>
<!--
  This is the widget's OWN layout — what actually gets drawn on the home screen.
  It's referenced from two places: sysmon_widget_info.xml's
  android:initialLayout, and directly by name in
  SysMonWidgetProvider.updateOneWidget() via RemoteViews(context.packageName,
  R.layout.widget_sysmon).

  IMPORTANT: widget layouts can ONLY use a small whitelist of View types that
  Android's RemoteViews system knows how to recreate inside the separate
  launcher process — things like LinearLayout, TextView, ListView, ImageView,
  Button. You can't drop in arbitrary custom Views the way you can in a normal
  Activity layout.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background_r26_inset"
    android:paddingTop="18dp"
    android:paddingBottom="12dp"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <!--
      Title row: the device name, centered, white like the Weather widget's
      city name. (The IP lives in the footer, above the status line.)
      Text set in code by SysMonWidgetProvider.updateOneWidget().
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/retro_white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="--" />

    </LinearLayout>

    <!--
      The stats, one per line (RAM, then Disk, then Status, ...), each with
      its value right-aligned and a usage bar where it applies. Rows come from
      a RemoteViewsService (SysMonRemoteViewsService.kt) — see
      SysMonWidgetProvider.attachListAdapter(). 0dp + weight 1 = fill whatever
      height the title and footer leave; scrolls if there are more stats than fit.
    -->
    <GridView
        android:id="@+id/statsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:numColumns="1"
        android:verticalSpacing="6dp"
        android:stretchMode="columnWidth"
        android:listSelector="@android:color/transparent"
        android:scrollbars="none" />

    <!--
      Footer, white and centered: the device's IP, then the status line —
      "Updated <time>" on a successful refresh, or "Unreachable — last <time>"
      if the device couldn't be reached. Both set in code by
      SysMonWidgetProvider.updateOneWidget().
    -->
    <TextView
        android:id="@+id/ipText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="@color/retro_white"
        android:textSize="13sp"
        android:singleLine="true"
        android:text="" />

    <TextView
        android:id="@+id/updatedText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:gravity="center"
        android:textColor="@color/retro_white"
        android:textSize="13sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="" />
</LinearLayout>
