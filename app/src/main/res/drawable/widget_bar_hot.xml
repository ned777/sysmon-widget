<?xml version="1.0" encoding="utf-8"?>
<!-- Usage bar under a widget stat (hot): dark track, @color/retro_red fill. Picked by percent in
     StatsRemoteViewsFactory — <75% ok (teal), 75-89% warn (yellow), 90%+ hot (red). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/bar_track" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/retro_red" />
                <corners android:radius="2dp" />
            </shape>
        </clip>
    </item>
</layer-list>
