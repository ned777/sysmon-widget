<?xml version="1.0" encoding="utf-8"?>
<!--
  A "vector drawable" — unlike a bitmap image (a fixed grid of pixel colors),
  this is a small set of drawing INSTRUCTIONS (paths, lines, circles) described
  as numbers, which Android re-renders crisply at whatever size it's actually
  displayed — no blurring or pixelation no matter how large or small the widget
  or screen ends up being.

  This draws the classic 80s "outrun" scene: a soft glowing sun sitting on a
  horizon line, with a perspective floor grid converging toward a vanishing
  point. It's meant to be layered ON TOP of a dark sunset gradient (see
  drawable/widget_background.xml and drawable/app_background.xml, which both
  reference this same file) — everything here is either a thin glowing line or
  a soft, mostly-transparent glow, so the gradient underneath always shows
  through.

  The `viewportWidth`/`viewportHeight` below define an internal coordinate
  system (300 x 180 units) that every path's coordinates are written in —
  Android stretches this to fill whatever the actual pixel size ends up being,
  so the same file works for a small widget and a full phone screen alike.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="300dp"
    android:height="180dp"
    android:viewportWidth="300"
    android:viewportHeight="180">

    <!--
      The sun: a soft circular glow (bright orange fading to fully transparent)
      centered right where the horizon line sits, drawn FIRST so the grid lines
      below get drawn on top of it, like the grid floor is in front of the sun.
      A radial gradient (defined inline via <aapt:attr>, which is how vector
      drawables express gradients that plain XML color attributes can't) is
      what gives it a soft glow instead of a hard-edged circle.
    -->
    <path android:pathData="M150,72 A28,28 0 1,0 150,128 A28,28 0 1,0 150,72 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="150"
                android:centerY="100"
                android:gradientRadius="30"
                android:startColor="#B3FF9F5A"
                android:endColor="#00FF9F5A" />
        </aapt:attr>
    </path>

    <!-- The horizon line itself: one bright, mostly-opaque horizontal line. -->
    <path
        android:pathData="M0,108 L300,108"
        android:strokeColor="@color/retro_cyan"
        android:strokeWidth="1.5"
        android:strokeAlpha="0.85" />

    <!--
      Horizontal "floor" lines below the horizon. Real perspective means lines
      further away (closer to the horizon) look closer together and fainter,
      while lines nearer the viewer (further down the widget) are further
      apart and brighter — that's why both the y-spacing AND the strokeAlpha
      below increase together as we move down the list.
    -->
    <path android:pathData="M20,116 L280,116" android:strokeColor="@color/retro_cyan" android:strokeWidth="1" android:strokeAlpha="0.25" />
    <path android:pathData="M5,126 L295,126" android:strokeColor="@color/retro_cyan" android:strokeWidth="1" android:strokeAlpha="0.35" />
    <path android:pathData="M-15,140 L315,140" android:strokeColor="@color/retro_cyan" android:strokeWidth="1.2" android:strokeAlpha="0.45" />
    <path android:pathData="M-40,158 L340,158" android:strokeColor="@color/retro_cyan" android:strokeWidth="1.3" android:strokeAlpha="0.55" />
    <path android:pathData="M-70,180 L370,180" android:strokeColor="@color/retro_cyan" android:strokeWidth="1.5" android:strokeAlpha="0.65" />

    <!--
      Vertical "floor" lines, all converging on the same single point where
      the horizontal center line meets the horizon (150,108) — that shared
      point is the "vanishing point" that makes this read as a floor
      receding into the distance rather than just a grid of squares.
    -->
    <path android:pathData="M150,108 L20,180" android:strokeColor="@color/retro_cyan" android:strokeWidth="1" android:strokeAlpha="0.4" />
    <path android:pathData="M150,108 L90,180" android:strokeColor="@color/retro_cyan" android:strokeWidth="1" android:strokeAlpha="0.4" />
    <path android:pathData="M150,108 L150,180" android:strokeColor="@color/retro_cyan" android:strokeWidth="1" android:strokeAlpha="0.4" />
    <path android:pathData="M150,108 L210,180" android:strokeColor="@color/retro_cyan" android:strokeWidth="1" android:strokeAlpha="0.4" />
    <path android:pathData="M150,108 L280,180" android:strokeColor="@color/retro_cyan" android:strokeWidth="1" android:strokeAlpha="0.4" />

</vector>
