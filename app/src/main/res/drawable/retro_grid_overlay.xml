<?xml version="1.0" encoding="utf-8"?>
<!--
  A "vector drawable" — unlike a bitmap image (a fixed grid of pixel colors),
  this is a small set of drawing INSTRUCTIONS (paths, lines) described as
  numbers, which Android re-renders crisply at whatever size it's actually
  displayed — no blurring or pixelation no matter how large or small the
  widget or screen ends up being.

  This draws a faint perspective floor grid converging toward a vanishing
  point on a horizon line — kept deliberately subtle (low strokeAlpha values
  throughout) since it's meant to be layered UNDER real UI text (see
  drawable/widget_background.xml, which references this file and also adds a
  dark scrim layer on top of it for contrast — see that file for why). This
  retro look is only used on the home-screen widget; the app's own screens
  use a plain black background (see themes.xml).

  The `viewportWidth`/`viewportHeight` below define an internal coordinate
  system (300 x 180 units) that every path's coordinates are written in —
  Android stretches this to fill whatever the actual pixel size ends up being,
  so the same file works for a small widget and a full phone screen alike.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="300dp"
    android:height="180dp"
    android:viewportWidth="300"
    android:viewportHeight="180">

    <!-- The horizon line itself: one thin, moderately faint horizontal line. -->
    <path
        android:pathData="M0,108 L300,108"
        android:strokeColor="@color/retro_cyan"
        android:strokeWidth="1.5"
        android:strokeAlpha="0.5" />

    <!--
      Horizontal "floor" lines below the horizon. Real perspective means lines
      further away (closer to the horizon) look closer together and fainter,
      while lines nearer the viewer (further down the widget) are further
      apart and brighter — that's why both the y-spacing AND the strokeAlpha
      below increase together as we move down the list. All kept faint
      overall so they read as texture, not as something competing with text.
    -->
    <path android:pathData="M20,116 L280,116" android:strokeColor="@color/retro_cyan" android:strokeWidth="1" android:strokeAlpha="0.22" />
    <path android:pathData="M5,126 L295,126" android:strokeColor="@color/retro_cyan" android:strokeWidth="1" android:strokeAlpha="0.2" />
    <path android:pathData="M-15,140 L315,140" android:strokeColor="@color/retro_cyan" android:strokeWidth="1.2" android:strokeAlpha="0.26" />
    <path android:pathData="M-40,158 L340,158" android:strokeColor="@color/retro_cyan" android:strokeWidth="1.3" android:strokeAlpha="0.32" />
    <path android:pathData="M-70,180 L370,180" android:strokeColor="@color/retro_cyan" android:strokeWidth="1.5" android:strokeAlpha="0.38" />

    <!--
      Vertical "floor" lines, all converging on the same single point where
      the horizontal center line meets the horizon (150,108) — that shared
      point is the "vanishing point" that makes this read as a floor
      receding into the distance rather than just a grid of squares.
    -->
    <path android:pathData="M150,108 L20,180" android:strokeColor="@color/retro_cyan" android:strokeWidth="1" android:strokeAlpha="0.22" />
    <path android:pathData="M150,108 L90,180" android:strokeColor="@color/retro_cyan" android:strokeWidth="1" android:strokeAlpha="0.22" />
    <path android:pathData="M150,108 L150,180" android:strokeColor="@color/retro_cyan" android:strokeWidth="1" android:strokeAlpha="0.22" />
    <path android:pathData="M150,108 L210,180" android:strokeColor="@color/retro_cyan" android:strokeWidth="1" android:strokeAlpha="0.22" />
    <path android:pathData="M150,108 L280,180" android:strokeColor="@color/retro_cyan" android:strokeWidth="1" android:strokeAlpha="0.22" />

</vector>
