<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget's full background, applied as android:background on the widget's
  root LinearLayout in widget_sysmon.xml. A <layer-list> stacks several
  drawables on top of each other, bottom item first — here that's three
  layers: the dark sunset gradient, the glowing grid/horizon artwork on top of
  it, and finally a thin neon border drawn as its own layer so its stroke
  stays crisp regardless of what's happening underneath.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Layer 1: the dark sunset gradient fill, rounded to match the border. -->
    <item>
        <shape android:shape="rectangle">
            <!--
              A 3-stop linear gradient: android:angle="270" means the gradient
              runs top-to-bottom (0 = left-to-right, and each +90 rotates
              another quarter-turn counterclockwise, so 270 = top-to-bottom).
              startColor is at the top, centerColor partway down, endColor at
              the bottom — giving the navy-to-magenta-to-rust "dusk sky" fade.
            -->
            <gradient
                android:angle="270"
                android:startColor="@color/sunset_top"
                android:centerColor="@color/sunset_mid"
                android:endColor="@color/sunset_bottom" />
            <corners android:radius="@dimen/widget_corner_radius" />
        </shape>
    </item>

    <!-- Layer 2: the grid/horizon/sun artwork, drawn over the gradient. -->
    <item android:drawable="@drawable/retro_grid_overlay" />

    <!-- Layer 3: a crisp neon cyan outline on top of everything else. -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="3dp"
                android:color="@color/retro_cyan" />
            <corners android:radius="@dimen/widget_corner_radius" />
        </shape>
    </item>

</layer-list>
