<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget's background: a true-black card with a crisp 2dp teal outline,
  matching the rest of the widget family (today-widget, weather-widget,
  vehicle-maintenance). The per-radius copies (widget_background_rNN*.xml)
  are generated from this file — see WidgetCorners.kt.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/black" />
            <corners android:radius="@dimen/widget_corner_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="2dp"
                android:color="@color/retro_teal" />
            <corners android:radius="@dimen/widget_corner_radius" />
        </shape>
    </item>
</layer-list>
